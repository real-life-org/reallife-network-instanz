# Domain dieser Instanz.
RLS_DOMAIN=reallife.network

# Name - setzt Dokumenttitel und erscheint ueberall, wo die App sich benennt.
RLS_APP_NAME=Reallife Network

# Dienste. Relay und Profile laufen auf demselben Server.
RLS_RELAY_URL=wss://relay.web-of-trust.de
RLS_PROFILES_URL=https://profiles.web-of-trust.de
RLS_DEFAULT_CONNECTOR=wot

# Gepinnte Fassung. Kein "latest" - eine Instanz kennt ihre Version.
#
# Stand von master (Revision f635f75), NICHT das Release 0.2.5: dort fehlt
# rls#274 "Erstsync auf neuen Geraeten sichtbar machen" - ohne den Commit kann
# die App auf einem frisch angemeldeten Geraet "noch leer" nicht von "kommt
# noch" unterscheiden und zeigt weder Gruppen noch eine Ladeanzeige.
# Der Digest steht dabei, damit dies eine feste Fassung bleibt und nicht mit
# dem naechsten master-Push wandert. Sobald 0.2.6 veroeffentlicht ist
# (release-please PR #284), gehoert hier wieder ein reines Versions-Tag hin.
RLS_IMAGE_TAG=edge@sha256:fe19da712d34c64a95efdee07819a362d21242d93f6f87b66a263c9c2173a0a7

# Rueckweg auf das letzte Release:
# RLS_IMAGE_TAG=0.2.5@sha256:0922021f8d1dbd83f57551d607ab736791ef936e0f3f61292b02400c6c9b95f0

# Favicon aus dem Branding-Mount.
RLS_FAVICON_URL=/branding/favicon.svg
