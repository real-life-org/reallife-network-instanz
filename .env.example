# Domain dieser Instanz.
RLS_DOMAIN=reallife.network

# Name - setzt Dokumenttitel und erscheint ueberall, wo die App sich benennt.
RLS_APP_NAME=Reallife Network

# Dienste. Relay und Profile laufen auf demselben Server.
RLS_RELAY_URL=wss://relay.web-of-trust.de
RLS_PROFILES_URL=https://profiles.web-of-trust.de
RLS_DEFAULT_CONNECTOR=wot

# Gepinnte Fassung. Kein "latest" - eine Instanz kennt ihre Version.
# Verfuegbare Tags: https://github.com/real-life-org/real-life-stack/pkgs/container/rls-app
#
# Der Digest gehoert dazu: das Tag allein koennte neu gesetzt werden, der
# Digest benennt genau die Fassung, die geprueft wurde.
RLS_IMAGE_TAG=0.2.8@sha256:1132d8239fd410c30488b11db5a062769c513479385dc2203a912bf0d9341a5b

# Nur fuer die lokale Vorschau, falls 8080 belegt ist
# RLS_PORT=8081

# Nur wenn euer Traefik-Netz anders heisst
# TRAEFIK_NETWORK=web
